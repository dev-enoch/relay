generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id              String    @id @default(uuid()) @db.Uuid
  type            String
  payload         Json
  status          String
  idempotency_key String
  request_hash    String?
  attempt_count   Int       @default(0)
  max_attempts    Int
  available_at    DateTime  @default(now())
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  started_at      DateTime?
  completed_at    DateTime?
  last_error_code String?
  owner_id        String?

  attempts      JobAttempt[]
  outbox_events OutboxEvent[]

  @@unique([owner_id, idempotency_key])
  @@map("jobs")
}

model JobAttempt {
  id                  String    @id @default(uuid()) @db.Uuid
  job_id              String    @db.Uuid
  attempt_number      Int
  worker_id           String
  started_at          DateTime  @default(now())
  finished_at         DateTime?
  outcome             String?
  duration_ms         Int?
  error_code          String?
  diagnostic_metadata Json?

  job Job @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@map("job_attempts")
}

model OutboxEvent {
  id                String    @id @default(uuid()) @db.Uuid
  type              String
  aggregate_id      String    @db.Uuid
  payload           Json
  created_at        DateTime  @default(now())
  dispatch_status   String    @default("PENDING")
  dispatch_attempts Int       @default(0)
  next_retry_at     DateTime?
  last_error_code   String?

  job Job @relation(fields: [aggregate_id], references: [id], onDelete: Cascade)

  @@map("outbox_events")
}

model ApiKey {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  owner_id    String
  description String?
  created_at  DateTime @default(now())
  is_active   Boolean  @default(true)

  @@map("api_keys")
}
